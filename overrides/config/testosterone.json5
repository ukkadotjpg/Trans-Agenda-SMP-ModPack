{
	"client": {
		// Whether to render a beard and mustache cosmetic on the player. (Type: boolean)
		"Beard_Mustache": true,
		// Whether to render the invincibility frame visual overlay. (Type: boolean)
		"Render_While_Invincible": true,
		// Whether to render the ability cooldown visual overlay. (Type: boolean)
		"Render_While_On_Cooldown": true,
		// RGB red color channel for the invincibility overlay. (Type: int, 0-255)
		"Red_Of_Invincible": 255,
		// RGB green color channel for the invincibility overlay. (Type: int, 0-255)
		"Green_Of_Invincible": 209,
		// RGB blue color channel for the invincibility overlay. (Type: int, 0-255)
		"Blue_Of_Invincible": 119,
		// RGB red color channel for the cooldown overlay. (Type: int, 0-255)
		"Red_Of_Cooldown": 255,
		// RGB green color channel for the cooldown overlay. (Type: int, 0-255)
		"Green_Of_Cooldown": 255,
		// RGB blue color channel for the cooldown overlay. (Type: int, 0-255)
		"Blue_Of_Cooldown": 0,
		// Whether to display the running speed indicator on the HUD. (Type: boolean)
		"Display_Speed": false,
		// Whether to render particle/visual trails behind the player. (Type: boolean)
		"Render_Trail": true,
		// Minimum distance in blocks for visual trail segments to render. (Type: double)
		"Minimum_Render_Distance": 2.0,
		// Positional offset of the visual trail. (Type: double)
		"Trail_Offset": 0.0
	},
	"server": {
		// Duration of the Man Power effect in ticks. (Type: int)
		"Duration": 40,
		// The power multiplier scaling the Man Power effect. (Type: int)
		"Multiplier": 10,
		// Maximum damage threshold that can be negated/absorbed by the Man Power effect. (Type: int)
		"Damage_Limit": 100,
		// Maximum running speed cap under Roid Rage. (Type: int)
		"Max_Speed": 200,
		// Activation speed threshold for custom abilities. (Type: int)
		"Ability_Speed": 50,
		// Height/velocity modifier applied to the custom super jump. (Type: double)
		"Jump_Height": 0.012,
		// Acceleration/speed modifier applied when sprinting during Roid Rage. (Type: double)
		"Speed_Multiplier": 0.0015,
		// Physics speed multiplier while in the air. (Type: double)
		"In_Air_Multiplier": 0.5,
		// Lifespan of particles/visual trails generated behind players during roid runs. (Type: int)
		"Trail_Duration": 5,
		// Impact radius of the ground slam shockwave. (Type: double)
		"Ground_Slam_Radius": 4.0,
		// Whether players are allowed to use Elytra during Roid Rage dashes. (Type: boolean)
		"Allow_Elytra": false,
		// Block limit of connected John Rocks toggled in a single redstone cascade. (Type: int)
		"Powered_Amount": 4096,
		// Whether John Rock propagation is allowed vertically. (Type: boolean)
		"Vertical": false,
		// Range in blocks for block conversion mechanics. (Type: int)
		"Conversion_Range": 3,
		// Movement speed boost multiplier applied when riding the Stupid Rat. (Type: double)
		"Rat_Boost_Multiplier": 5.0
	}
}